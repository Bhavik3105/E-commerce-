{
  "name": "jummip-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Jummip store API. Prices are stored in paise.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && esbuild src/app.ts --bundle --platform=node --target=node22 --outfile=server.cjs --format=cjs",
    "start": "node dist/index.js",
    "seed": "tsx src/seed.ts"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "mongoose": "^9.12.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
