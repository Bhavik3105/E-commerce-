PORT=5000
# Paste this only in backend/.env on your machine. Do not commit it.
MONGODB_URI=
CORS_ORIGIN=http://localhost:3000
ADMIN_PASSWORD=
# Razorpay test or live keys. The secret stays on the API. Do not commit it.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Password reset email. Use the store mailbox SMTP settings. Do not commit the password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
STORE_URL=http://localhost:3000
